# Copy to .env in this same directory (infra/) before running docker compose.
# Never commit the real .env.

# Shared Postgres instance — 3 schemas provisioned by infra/postgres/init in Step 3.
POSTGRES_USER=csb_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=company_second_brain
POSTGRES_PORT=5432

# Least-privilege role passwords, read once by infra/postgres/init/03_roles_and_grants.sh on
# first container init. Each MUST match the password portion of the corresponding service's
# DATABASE_URL in its own .env.example — they are not looked up automatically.
RESUME_INTEL_ROLE_PASSWORD=changeme
SECOND_BRAIN_ROLE_PASSWORD=changeme
RECRUITMENT_ROLE_PASSWORD=changeme

# Host-side ports (containers always listen on 8000 internally)
RESUME_INTELLIGENCE_PORT=8001
SECOND_BRAIN_PORT=8002
RECRUITMENT_WORKFLOW_PORT=8003
VOICEHR_PORT=8000

# Host Ollama model store, bind-mounted into the ollama service (docker-compose.yml) so
# already-downloaded weights are shared instead of re-fetched into a named volume.
# Linux/macOS: $HOME/.ollama   Windows: C:/Users/<you>/.ollama
OLLAMA_MODELS_DIR=C:/Users/you/.ollama
