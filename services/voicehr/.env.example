# Copy to .env in this same directory before running docker compose. Never commit the real .env.
#
# The section below reproduces VoiceHR's own existing .env.example values (unchanged) so this
# service still runs standalone exactly as it does outside this monorepo. Only the final
# section is new, added for RWS integration.

# --- Existing VoiceHR configuration (unchanged) ---
# Gemini is the sole AI provider for this project (see docs/ARCHITECTURE_DECISIONS.md) -- for both interview
# evaluation and the Gemini Live interview-conduct pipeline. No other provider is
# supported.
GEMINI_API_KEY=
# gemini-2.5-flash was retired by the provider (404 NOT_FOUND for new callers); use
# gemini-3.6-flash, matching the same fix already applied to RWS's own GEMINI_MODEL.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EVALUATION_MODEL=gemini-3.6-flash

# Gemini Live is the only interview-conduct implementation VoiceHR uses in this
# project -- it needs GEMINI_API_KEY set; GEMINI_LIVE_MODEL/VOICE tune which Live
# model/voice it connects to.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# REQUIRED for POST /api/invite to succeed at all (see handoff.md milestone 27):
# VoiceHR now emails the candidate their secure interview link automatically as part
# of that same call, and a successful send is what makes the invite succeed -- with
# this unset, every invite fails with a clean 500 ("Email delivery not configured.
# Set RESEND_API_KEY in .env."), by design (fail loud, not silent). Get a real key
# from https://resend.com/api-keys. Never commit a real value here or anywhere else.
RESEND_API_KEY=
# Sender identity for outbound emails, e.g. "VoiceHR <you@yourdomain.com>". Defaults to
# Resend's own unverified-domain sandbox sender (VoiceHR <onboarding@resend.dev>) if left
# unset -- never put the API key here. IMPORTANT: Resend's sandbox sender can only deliver
# to the email address the Resend account itself is registered under -- it will silently
# fail (or bounce) for any other recipient. To actually invite real/arbitrary candidate
# email addresses, verify a real sending domain in the Resend dashboard
# (https://resend.com/domains) and set RESEND_FROM_ADDRESS to an address on that domain,
# e.g. "VoiceHR <interviews@yourdomain.com>".
RESEND_FROM_ADDRESS=
ADMIN_EMAIL=

BASE_URL=http://localhost:8000

# HTTP Basic auth for the admin/report-management surface (/admin, /admin/reports,
# /api/admin/reports*, /recordings/*) -- protects candidate PII, transcripts,
# recordings, and scores. Not a user database or session system. Change both in any
# real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin-password

# --- New: RWS integration additions (this project only, added on top of the existing app) ---
# Service-key auth for inbound RWS -> VoiceHR calls (POST /api/invite)
RWS_SERVICE_API_KEY=changeme-voicehr-key

# HMAC secret for signing the outbound interview-completion webhook to RWS
RWS_WEBHOOK_HMAC_SECRET=changeme-webhook-secret
RWS_WEBHOOK_URL=http://recruitment-workflow:8000/v1/webhooks/voicehr
