# Copy to .env in this same directory before running docker compose. Never commit the real .env.

SERVICE_NAME=second-brain
PORT=8000
LOG_LEVEL=INFO

# Least-privilege role for the second_brain schema only — created in Step 3, no cross-schema grants.
DATABASE_URL=postgresql+psycopg://second_brain_role:changeme@postgres:5432/company_second_brain?options=-csearch_path%3Dsecond_brain

# Presented by callers (RWS, Resume Intelligence) to this service's endpoints
SERVICE_API_KEY=changeme-second-brain-key

# AI provider — same embedding model used for candidates and JDs (required for valid cosine comparison)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
