# Copy to .env in this same directory before running docker compose. Never commit the real .env.

SERVICE_NAME=recruitment-workflow
PORT=8000
LOG_LEVEL=INFO

# Least-privilege role for the recruitment schema only — created in Step 3, no cross-schema grants.
DATABASE_URL=postgresql+psycopg://recruitment_role:changeme@postgres:5432/company_second_brain?options=-csearch_path%3Drecruitment

# This service's own key, presented to callers (VoiceHR webhook, recruiter-facing routes use JWT instead)
SERVICE_API_KEY=changeme-recruitment-workflow-key

# Keys this service presents when calling the others
SECOND_BRAIN_API_KEY=changeme-second-brain-key
RESUME_INTELLIGENCE_API_KEY=changeme-resume-intelligence-key
VOICEHR_API_KEY=changeme-voicehr-key

# Webhook verification (VoiceHR -> RWS)
WEBHOOK_HMAC_SECRET=changeme-webhook-secret

# Recruiter auth (one seeded account, no registration system)
JWT_SECRET=changeme-jwt-secret
JWT_EXPIRY_MINUTES=45

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
