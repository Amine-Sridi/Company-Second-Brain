# Copy to .env in this same directory before running docker compose. Never commit the real .env.
#
# Every variable below is actually read by this service (api.py's Settings, or db.py/
# alembic/env.py's own direct DATABASE_URL lookup) -- nothing here is unused. The service
# always listens on port 8000 inside its container regardless of any $PORT value; the
# host-side port mapping is controlled by infra/.env's RESUME_INTELLIGENCE_PORT instead.

LOG_LEVEL=INFO

# Least-privilege role for the resume_intel schema only — created in Step 3, no cross-schema grants.
DATABASE_URL=postgresql+psycopg://resume_intel_role:changeme@postgres:5432/company_second_brain?options=-csearch_path%3Dresume_intel

# Presented by callers (RWS) to this service's endpoints
SERVICE_API_KEY=changeme-resume-intelligence-key

# Gemini is the sole AI provider for this project (see docs/ARCHITECTURE_DECISIONS.md). Used for the
# structured resume-extraction call (pipeline/parsing_agent.py via shared/llm.py).
# gemini-2.5-flash was retired by the provider (404 NOT_FOUND for new callers); use
# gemini-3.6-flash, matching the same fix already applied to every other service.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Second Brain: PII-safe CandidateSummary is pushed here after a resume is stored
# (see pipeline/candidate_summary.py, second_brain_client.py).
SECOND_BRAIN_URL=http://second-brain:8000
SECOND_BRAIN_API_KEY=changeme-second-brain-key
