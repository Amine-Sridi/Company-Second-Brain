# Copy to .env in this same directory before running docker compose. Never commit the real .env.

SERVICE_NAME=resume-intelligence
PORT=8000
LOG_LEVEL=INFO

# Least-privilege role for the resume_intel schema only — created in Step 3, no cross-schema grants.
DATABASE_URL=postgresql+psycopg://resume_intel_role:changeme@postgres:5432/company_second_brain?options=-csearch_path%3Dresume_intel

# Presented by callers (RWS) to this service's endpoints
SERVICE_API_KEY=changeme-resume-intelligence-key

# AI provider — wired in Step 6/7
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
